    "applies_when": [
      "开发或审计自动化、半自动化实盘交易系统",
      "交易系统通过交易所 API 下单、撤单、查询订单、监听订单事件或同步仓位",
      "需要处理部分成交、撤单、过期、断线、未知订单状态、仓位不一致或急停恢复"
    ],
    "not_applicable_when": [
      "离线回测或模拟盘没有真实交易所账户状态",
      "人工交易系统没有自动下单权限，但仍可参考审计门",
      "使用其他交易所或经纪商接口时，必须先映射该平台自己的订单状态、账户事件和撤单语义"
    ],
    "assumptions": [
      "系统可以访问交易所用户数据流和 REST 查询接口",
      "系统保存本地订单 ID、client order ID、累计成交数量、平均成交价、订单状态和仓位快照",
      "系统具备在状态不确定时阻断新开仓或触发保护流程的能力"
    ],
    "limitations": [
      "来源以 Binance USDⓈ-M Futures 为主，其他市场需要重新映射状态枚举和接口语义",
      "该候选不定义具体交易策略、仓位规模或投资建议",
      "自动撤单和急停属于安全工具，不能替代完整的账户权限、风控和人工恢复流程"
    ]
  },
