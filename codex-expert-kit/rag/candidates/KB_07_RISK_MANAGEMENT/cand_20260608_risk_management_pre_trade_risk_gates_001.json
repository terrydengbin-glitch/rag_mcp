  "claim": {
    "claim_id": "claim_001",
    "statement": "自动化交易系统必须在订单进入执行适配器或交易所前执行风险闸门检查，至少覆盖账户/策略/订单级风险限额、财务暴露、订单大小、权限、异常订单、连接状态和触发后保护动作；信号强度不得绕过这些闸门。",
    "normalized_claim": "automated_trading_requires_pre_trade_risk_gates_before_order_entry_covering_exposure_limits_order_size_permissions_erroneous_orders_connectivity_and_protective_actions",
    "evidence_summary": "SEC Rule 15c3-5 要求市场接入风险控制用于限制财务暴露、防止超过预设信用/资本阈值或疑似错误订单进入市场；CFTC 自动交易风险控制概念发布讨论预交易风控、交易后报告、系统保障和自动化交易安全；CME 风控工具说明风险限额、订单管理、权限、Cancel on Disconnect、实时监控、审计轨迹和 Kill Switch。",
    "interpretation_notes": "本候选将监管和交易所级风险控制抽象为 CEK-TA 工程规则：策略信号只是订单候选，只有通过风险闸门后才能提交执行；风险闸门失败应产生拒单、减仓/撤单/急停候选动作和审计日志，而不是静默放行。",
    "claim_strength": "strong",
    "performance_claim": false
  },
  "applicability": {
    "market": "general",
    "asset": "multi",
    "timeframe": "general",
    "data_granularity": "account_event",
    "project_type": "general",
    "applies_when": [
      "策略信号会转化为真实订单、模拟盘订单或实盘前验证订单",
      "系统需要限制账户、策略、资产、订单或连接级风险暴露",
      "订单提交前需要检查最大订单量、名义价值、保证金、权限、日内亏损、持仓暴露、重复订单或连接健康"
    ],
    "not_applicable_when": [
      "任务只处理离线文档、UI 展示或不产生订单的分析流程",
      "系统处于纯研究阶段且订单不会进入模拟盘或实盘执行层，但仍建议在回测报告中声明缺失风控",
      "交易所、经纪商或监管规则要求更严格控制时，以更严格规则为准"
    ],
    "assumptions": [
      "系统存在从信号到订单的执行适配器或交易接入层",
      "风险限额可以工程化为订单前检查、状态机和审计日志",
      "本候选不规定具体阈值，只规定必须存在可审计的风险闸门"
    ],
    "limitations": [
      "SEC、CFTC、CME 来源主要来自美国证券/衍生品/交易所风险管理语境，迁移到 crypto 或其他司法辖区需重新映射",
      "本候选不推荐具体仓位比例、杠杆、日亏损金额或交易策略",
      "风险闸门不能替代订单状态机、仓位同步、kill switch 和人工恢复流程"
    ]
  },
