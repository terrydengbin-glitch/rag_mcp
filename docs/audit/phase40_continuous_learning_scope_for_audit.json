  "audit_objective": "审计 Phase 40 持续学习知识范围、L3 专题结构、36 条知识点规划、上下游边界和采集门槛是否适合作为后续专业 RAG 知识库扩展范围。",
  "instructions_for_auditor": {
    "language": "中文",
    "review_focus": [
      "检查是否严格区分持续学习、周期再训练、受控发布和在线自动学习。",
      "检查是否阻断再训练结果自动替换 champion model。",
      "检查是否阻断 LLM audit assistant 成为最终交易 gate。",
      "检查是否把 K 线、fill model、订单状态机、风控本体等 Trading Engineering 内容错误塞入 AI Engineering。",
      "检查 10 个 L3 专题是否覆盖外接交易 LLM gating/scoring 项目的长期反馈闭环。",
      "检查 36 条知识点是否数量合理、无明显遗漏、无重复、无互相矛盾。",
      "检查三份契约是否足够支撑后续候选知识采集和外接项目开发。"
    ],
    "required_output": {
      "overall_decision": "approve | approve_with_changes | needs_revision | reject",
