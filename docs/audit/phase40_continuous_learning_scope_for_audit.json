    {
      "id": "P40-C02",
      "priority": "P0-Core",
      "target_canonical_node_id": "kt.ai_feedback_governance.feedback_logging",
      "statement": "feedback record 必须保存决策时特征、scorer 输出、LLM 审计输出、final gate 决策和后验结果引用。"
    },
    {
      "id": "P40-C03",
      "priority": "P0-Core",
      "target_canonical_node_id": "kt.ai_feedback_governance.feedback_logging",
      "statement": "被阻断候选也必须保留 opportunity-cost 评估入口，避免只学习已成交样本。"
    },
    {
      "id": "P40-C04",
      "priority": "P0-Core",
      "target_canonical_node_id": "kt.ai_feedback_governance.label_refresh",
      "statement": "标签不能只用 PnL，必须覆盖交易质量、规则违规、风控违规、执行质量和人工复核。"
    },
