  "created_at": "2026-06-09",
  "purpose": "供人工或外部 AI 审计评估 Phase 37 Trading Engineering 需要补齐的交易专业知识库分区、知识点范围、边界、缺口和优先级。",
  "important_boundary": {
    "not_formal_knowledge": true,
    "not_default_guidance": true,
    "not_approved": true,
    "description": "本 JSON 只是 Trading Engineering 知识采集范围和审计清单，不是正式知识卡，不得作为 MCP/SearchLab/外部项目默认指导。所有知识点必须后续经过联网采集、来源评分、冲突审计、候选审核、formal reviewed/approved 治理流程。"
  },
  "branch_boundary_policy": {
    "core_rule": "Trading Engineering 沉淀交易专业规则本体；AI Engineering 只引用这些交易知识并定义训练、检索、评估和治理方式。",
    "trading_engineering_owns": [
      "量化基础、EV、R/R、成本、仓位和交易决策流",
      "市场数据工程、时间对齐、缺失重复、时区和数据版本",
      "K 线结构、指标边界、多周期、入场、止损和止盈",
      "市场微观结构、盘口、流动性、订单流和执行成本",
      "回测可信度、数据泄漏、过拟合、样本外和成本模型",
      "回放、模拟盘、fill model、同根 K TP/SL、滑点和延迟",
      "实盘执行、订单状态机、仓位同步、kill switch 和事故恢复",
      "风险管理、单笔风险、日亏损、组合暴露和风控闸门",
      "交易复盘、坏例 taxonomy、R/R 分解和交易质量归因"
    ],
    "trading_engineering_must_not_include": [
      "LLM/SFT/DPO/PEFT 训练方法本体",
      "RAG/MCP tool contract 本体",
      "模型部署、LLMOps 和 AI governance 本体",
      "外部项目私有策略参数、账户事实、密钥和实盘配置"
    ],
    "ai_engineering_usage": "AI Engineering 只能通过 knowledge_refs、retrieved_knowledge、label_schema、eval_case、gate_policy 引用 Trading Engineering 知识，不得复制或改写交易规则本体。",
    "audit_check": "审计时如果发现某个知识点主要描述训练、检索、部署或 AI 治理，应移回 AI Engineering；如果描述交易规则本体，应留在 Trading Engineering。"
  },
  "audit_instructions": {
    "auditor_goal": "评估 Trading Engineering P0 知识范围是否覆盖外接 LLM gating/scoring 项目开发所需的交易专业基础，同时避免和 AI Engineering、RAG Engineering、MCP Engineering 重复。",
    "auditor_should_check": [
      "P0 知识点是否覆盖交易数据、信号、回测、模拟、实盘、风控和复盘闭环。",
      "是否存在应归入 AI Engineering 的训练、部署、评估、RAG/MCP 规则。",
      "是否存在项目私有事实、具体买卖建议、无边界交易结论或无法通用的策略参数。",
      "是否缺少关键交易工程知识点。",
      "命名是否清晰，是否便于后续转换为 knowledge_id、canonical_node_id 和 ResearchIngestionTask。",
      "每个分组是否可以独立采集、独立审计、独立沉淀。"
    ],
    "auditor_output_expected": {
      "decision": "accept | accept_with_changes | reject",
      "missing_items": "列出建议补充的知识点",
      "move_to_ai_engineering": "列出应移到 AI Engineering 的知识点",
      "move_to_other_branch": "列出应移到其他分支的知识点",
      "merge_or_split": "列出需要合并或拆分的知识点",
      "risk_notes": "列出来源、冲突、泛化、项目污染或默认指导风险",
      "priority_changes": "列出建议调整优先级的知识点"
    }
  },
