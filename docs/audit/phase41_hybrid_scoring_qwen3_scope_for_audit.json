    "related_phases": [
      "Phase 36 AI Engineering gating/scoring 知识",
      "Phase 38 AI 模型平台与交易 Gating/Scoring POC",
      "Phase 40 Continuous Learning 与再训练闭环",
      "Phase 37 Trading Engineering 知识扩展"
    ]
  },
  "scope_boundary": {
    "in_scope": [
      "表格/统计模型作为 numeric scorer、risk ranking、review priority",
      "Logistic Regression、LightGBM、XGBoost、CatBoost 的模型家族选择和比较边界",
      "类别不平衡、sample weight、HPO 防泄漏、时间切分和 entity group split",
      "校准集、Platt/isotonic、Brier/ECE、uncertainty bucket、abstain band 和 threshold policy",
      "point-in-time feature join、feature_available_time、offline/online parity、feature lineage",
      "Qwen3 Audit Assistant 的 strict JSON、reason code、RAG citation、no-hit abstain、unsupported claim",
      "Qwen3 SFT/DPO/LoRA/RAG-first 的训练边界",
      "Hybrid runtime trace、release manifest、model registry、rollback target、kill switch",
      "MLflow、Ray、Kubeflow、Feast、vLLM 的条件引入和治理边界"
    ],
    "out_of_scope": [
      "K 线形态、技术指标、交易信号有效性本体",
      "回测偏差、fill model、滑点、订单状态机、仓位、风控规则本体",
      "真实模型训练、真实 Qwen3 部署、真实交易账户或密钥",
      "把 Qwen3 作为 numeric scorer 或 final gate",
      "把 LightGBM、XGBoost、Logistic Regression、CatBoost 直接作为交易放行权限",
      "把 candidate/reviewed 自动升级为 approved",
      "新增数据库或外部平台运行时依赖"
    ],
    "routing_rule": "AI Engineering 只保存训练、评分、校准、审计、检索、发布和治理方法；K 线、fill model、执行、仓位、风控等交易规则本体必须路由到 Phase 37 / Trading Engineering。Phase 41 只能通过 related_trading_refs 引用这些交易规则。"
  },
